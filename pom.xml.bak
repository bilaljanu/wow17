  <build>
    <plugins>
      <!-- AntRun plugin to run Patcher3 and stub Mojang libraries -->
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <!-- Copy stubs (if any) -->
          <execution>
            <id>copy-stubs</id>
            <phase>compile</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <copy todir="${project.build.outputDirectory}">
                  <fileset dir="${project.basedir}/build/stubs"/>
                </copy>
              </target>
            </configuration>
          </execution>
          <!-- Patch the main Minecraft JAR (replace ClientConnection, strip Netty/log4j, stub Mojang classes) -->
          <execution>
            <id>patch-classes</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <java classname="poc.patch.Patcher3" fork="true">
                  <classpath>
                    <pathelement path="${project.basedir}/build/patcher-classes"/>
                    <pathelement path="${project.basedir}/tools/asm-9.6.jar"/>
                    <pathelement path="${project.basedir}/tools/asm-tree-9.6.jar"/>
                    <pathelement path="${project.basedir}/build/mc-named.jar"/>
                    <pathelement path="${project.basedir}/build/compat-stubs.jar"/>
                    <fileset dir="${project.basedir}/input/libs">
                      <include name="**/*.jar"/>
                    </fileset>
                    <pathelement path="${settings.localRepository}/org/teavm/teavm-core/${teavm.version}/teavm-core-${teavm.version}.jar"/>
                    <pathelement path="${settings.localRepository}/org/teavm/teavm-jso/${teavm.version}/teavm-jso-${teavm.version}.jar"/>
                    <pathelement path="${settings.localRepository}/org/ow2/asm/asm/9.6/asm-9.6.jar"/>
                    <pathelement path="${settings.localRepository}/org/ow2/asm/asm-commons/9.6/asm-commons-9.6.jar"/>
                    <pathelement path="${settings.localRepository}/org/ow2/asm/asm-tree/9.6/asm-tree-9.6.jar"/>
                    <pathelement path="${settings.localRepository}/org/ow2/asm/asm-analysis/9.6/asm-analysis-9.6.jar"/>
                  </classpath>
                  <arg value="${project.basedir}/build/mc-named.jar"/>
                  <arg value="${project.basedir}/build/mc-patched-stubbed.jar"/>
                </java>
              </target>
            </configuration>
          </execution>
          <!-- Stub Mojang library JARs -->
          <execution>
            <id>stub-authlib</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.basedir}/build/mojang-stubbed"/>
                <java classname="poc.patch.Patcher3" fork="true">
                  <classpath>
                    <pathelement path="${project.basedir}/build/patcher-classes"/>
                    <pathelement path="${project.basedir}/tools/asm-9.6.jar"/>
                  </classpath>
                  <arg value="${project.basedir}/input/libs/com/mojang/authlib/6.0.54/authlib-6.0.54.jar"/>
                  <arg value="${project.basedir}/build/mojang-stubbed/authlib-6.0.54-stubbed.jar"/>
                </java>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>stub-blocklist</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals
            <configuration>
              <target>
                <java classname="poc.patch.Patcher3" fork="true">
                  <classpath>
                    <pathelement path="${project.basedir}/build/patcher-classes"/>
                    <pathelement path="${project.basedir}/tools/asm-9.6.jar"/>
                  </classpath>
