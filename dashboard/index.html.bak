<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MC-in-Browser Port — Live Progress</title>
<style>
  :root {
    --bg: #0a0e14;
    --panel: #11161f;
    --panel2: #161d29;
    --border: #1f2836;
    --text: #dbe4f0;
    --dim: #64748b;
    --accent: #4c9aff;
    --ok: #34d399;
    --warn: #fbbf24;
    --bad: #f87171;
    --purple: #c084fc;
  }
  * { box-sizing: border-box; }
  body {
    background: var(--bg); color: var(--text);
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Consolas, monospace;
    margin: 0; padding: 2rem 1.5rem; line-height: 1.5;
  }
  .wrap { max-width: 1120px; margin: 0 auto; }

  header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: .4rem; }
  h1 { font-size: 1.15rem; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
  h1 span { color: var(--accent); }
  .live { display: flex; align-items: center; gap: .5rem; font-size: .78rem; color: var(--dim); }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--bad); }
  .dot.on { background: var(--ok); animation: pulse 2s ease-out infinite; }
  .dot.pulse-now { animation: pulseLive 0.6s ease-out; }
  @keyframes pulseLive {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(52,211,153,.45); }
    70%  { box-shadow: 0 0 0 8px rgba(52,211,153,0); }
    100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); }
  }
  .subline { color: var(--dim); font-size: .8rem; margin-bottom: 2.2rem; }
  .debug-line { font-size: .72rem; color: var(--dim); margin-top: .25rem; }
  .debug-line b { color: var(--text); }

  /* status banner */
  .status-banner { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .stat-box {
    flex: 1; min-width: 140px;
    background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
    padding: 1rem 1.15rem;
  }
  .stat-box .stat-label { font-size: .65rem; text-transform: uppercase; letter-spacing: .09em; color: var(--dim); margin-bottom: .3rem; }
  .stat-box .stat-val { font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stat-box .stat-sub { font-size: .72rem; color: var(--dim); margin-top: .2rem; }
  .stat-val.ok { color: var(--ok); }
  .stat-val.bad { color: var(--bad); }
  .stat-val.warn { color: var(--warn); }

  /* phase stepper */
  .stepper { display: flex; align-items: flex-start; margin-bottom: 2.2rem; }
  .step { flex: 1; text-align: center; position: relative; min-width: 0; }
  .step::before, .step::after {
    content: ""; position: absolute; top: 14px; width: 50%; height: 2px; background: var(--border);
  }
  .step::before { left: 0; } .step::after { right: 0; }
  .step:first-child::before, .step:last-child::after { display: none; }
  .step.done::before, .step.done::after,
  .step.active::before { background: var(--accent); }
  .knob {
    position: relative; z-index: 1; width: 30px; height: 30px; margin: 0 auto .5rem;
    border-radius: 50%; background: var(--panel2); border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: .75rem; color: var(--dim); transition: all .3s;
  }
  .step.active .knob {
    border-color: var(--accent); color: var(--accent);
    box-shadow: 0 0 0 5px rgba(76,154,255,.12); animation: glow 2s ease-in-out infinite;
  }
  @keyframes glow {
    0%,100% { box-shadow: 0 0 0 4px rgba(76,154,255,.10); }
    50%     { box-shadow: 0 0 0 8px rgba(76,154,255,.04); }
  }
  .step.done .knob { border-color: var(--accent); background: var(--accent); color: #0a0e14; }
  .step-label { font-size: .68rem; color: var(--dim); padding: 0 .3rem; line-height: 1.35; }
  .step.active .step-label { color: var(--text); }
  .step-label b { display: block; font-weight: 600; }

  /* cards */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
    padding: 1.15rem 1.25rem; transition: border-color .2s;
  }
  .card:hover { border-color: #33415580; }
  .card.wide { grid-column: 1 / -1; }

  /* progress section */
  .progress-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: .9rem; flex-wrap: wrap; gap: .5rem; }
  .progress-header h2 { font-size: .68rem; text-transform: uppercase; letter-spacing: .09em; color: var(--dim); margin: 0; font-weight: 600; }
  .trend-pill { font-size: .72rem; font-weight: 700; padding: .25rem .75rem; border-radius: 999px; }
  .trend-pill.improving { color: var(--ok); background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.3); }
  .trend-pill.stalled { color: var(--warn); background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.3); }
  .trend-pill.blocked { color: var(--bad); background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); }
  .trend-pill.idle { color: var(--dim); background: var(--panel2); border: 1px solid var(--border); }

  .burndown-canvas { width: 100%; height: 220px; display: block; }
  .burndown-legend { display: flex; gap: 1.2rem; margin-top: .6rem; font-size: .72rem; color: var(--dim); flex-wrap: wrap; }
  .burndown-legend span { display: flex; align-items: center; gap: .35rem; }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .legend-line { width: 16px; height: 2px; display: inline-block; border-radius: 1px; }

  .card h2 {
    font-size: .68rem; text-transform: uppercase; letter-spacing: .09em;
    color: var(--dim); margin: 0 0 .85rem; font-weight: 600;
  }
  .big { font-size: 1.7rem; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .muted { color: var(--dim); }

  .pill {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .95rem; font-weight: 700; padding: .35rem .9rem; border-radius: 999px;
    background: var(--panel2); border: 1px solid var(--border); color: var(--dim);
  }
  .pill.ok   { color: var(--ok);   border-color: rgba(52,211,153,.35); background: rgba(52,211,153,.08); }
  .pill.bad  { color: var(--bad);  border-color: rgba(248,113,113,.35); background: rgba(248,113,113,.08); }
  .pill.warn { color: var(--warn); border-color: rgba(251,191,36,.35); background: rgba(251,191,36,.08); }
  .meta { color: var(--dim); font-size: .74rem; margin-top: .55rem; word-break: break-all; }

  /* live activity feed */
  .feed { max-height: 420px; overflow-y: auto; scroll-behavior: smooth; }
  .feed-item {
    display: grid; grid-template-columns: auto 1fr; gap: .6rem; align-items: start;
    padding: .55rem 0; border-bottom: 1px solid var(--border); font-size: .82rem;
    animation: fadeIn .3s ease;
  }
  .feed-item:last-child { border-bottom: none; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  .feed-icon { font-size: .72rem; font-weight: 700; padding: .15rem .5rem; border-radius: 999px; white-space: nowrap; }
  .feed-icon.action  { color: var(--accent); background: rgba(76,154,255,.12); border: 1px solid rgba(76,154,255,.3); }
  .feed-icon.file    { color: var(--ok);    background: rgba(52,211,153,.1);  border: 1px solid rgba(52,211,153,.3); }
  .feed-icon.build   { color: var(--warn);  background: rgba(251,191,36,.1);  border: 1px solid rgba(251,191,36,.3); }
  .feed-icon.error   { color: var(--bad);   background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); }
  .feed-icon.decision{ color: var(--purple); background: rgba(192,132,252,.1); border: 1px solid rgba(192,132,252,.3); }
  .feed-body { line-height: 1.4; }
  .feed-body .feed-text { color: var(--text); }
  .feed-body .feed-detail { color: var(--dim); font-size: .76rem; margin-top: .15rem; }
  .feed-body code {
    font-size: .78rem; background: var(--panel2); padding: .1rem .35rem;
    border-radius: 4px; color: var(--accent);
  }
  .feed-time { color: var(--dim); font-size: .7rem; }

  /* agents */
  .chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .chip {
    background: rgba(76,154,255,.09); border: 1px solid rgba(76,154,255,.4);
    color: var(--accent); padding: .18rem .7rem; border-radius: 999px; font-size: .78rem;
  }

  /* errors */
  .err-row { display: grid; grid-template-columns: 150px 1fr 3rem; align-items: center; gap: .8rem; padding: .32rem 0; font-size: .84rem; }
  .err-row:last-child { padding-bottom: 0; }
  .err-name { color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-track { height: 6px; background: var(--panel2); border-radius: 999px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 999px; background: var(--accent); transition: width .6s ease; min-width: 0; }
  .bar-fill.zero { background: var(--border); }
  .bar-fill.red { background: var(--bad); } .bar-fill.amber { background: var(--warn); }
  .err-num { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
  .total-line { display: flex; justify-content: space-between; align-items: baseline; margin-top: .9rem; padding-top: .7rem; border-top: 1px dashed var(--border); font-size: .82rem; color: var(--dim); }
  .total-line b { font-size: 1.05rem; color: var(--text); font-variant-numeric: tabular-nums; }

  /* error detail expandable */
  .err-detail-panel { margin-top: .6rem; border-top: 1px dashed var(--border); padding-top: .6rem; display: none; }
  .err-detail-panel.open { display: block; }
  .err-detail-row { display: flex; justify-content: space-between; align-items: center; padding: .25rem 0; font-size: .78rem; border-bottom: 1px solid rgba(31,40,54,.5); }
  .err-detail-row:last-child { border-bottom: none; }
  .err-detail-sym { color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; margin-right: .5rem; }
  .err-detail-sym code { font-size: .74rem; }
  .err-detail-cnt { color: var(--accent); font-weight: 600; min-width: 2rem; text-align: right; }
  .expand-btn {
    background: none; border: 1px solid var(--border); color: var(--dim);
    font: inherit; font-size: .68rem; padding: .15rem .55rem; border-radius: 999px;
    cursor: pointer; margin-top: .5rem;
  }
  .expand-btn:hover { color: var(--text); border-color: var(--accent); }

  /* decisions */
  .dec-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--border); font-size: .88rem; }
  .dec-row:last-child { border-bottom: none; padding-bottom: 0; }
  .dec-row:first-of-type { padding-top: 0; }
  .tag { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; padding: .18rem .65rem; border-radius: 999px; white-space: nowrap; }
  .tag.pending { color: var(--dim); border: 1px solid var(--border); background: var(--panel2); }
  .tag.locked { color: var(--ok); border: 1px solid rgba(52,211,153,.35); background: rgba(52,211,153,.08); }
  .dec-val.pending { color: var(--dim); font-style: italic; }

  /* build log viewer */
  .log-controls { display: flex; gap: .5rem; margin-bottom: .8rem; align-items: center; flex-wrap: wrap; }
  .log-controls select, .log-controls button {
    background: var(--panel2); border: 1px solid var(--border); color: var(--dim);
    font: inherit; font-size: .74rem; padding: .25rem .65rem; border-radius: 6px; cursor: pointer;
  }
  .log-controls select:focus, .log-controls button:hover { color: var(--text); border-color: var(--accent); outline: none; }
  .log-controls .filter-input {
    background: var(--panel2); border: 1px solid var(--border); color: var(--text);
    font: inherit; font-size: .74rem; padding: .25rem .65rem; border-radius: 6px; flex: 1; min-width: 120px;
  }
  .log-controls .filter-input:focus { border-color: var(--accent); outline: none; }
  .log-controls .filter-input::placeholder { color: var(--dim); }
  .log-viewer {
    background: #0d1117; border: 1px solid var(--border); border-radius: 8px;
    padding: .8rem 1rem; max-height: 500px; overflow-y: auto; overflow-x: hidden;
    font-size: .76rem; line-height: 1.6; scroll-behavior: smooth;
  }
  .log-line { white-space: pre-wrap; word-break: break-all; }
  .log-line .ln { color: var(--dim); user-select: none; display: inline-block; width: 3.5rem; text-align: right; margin-right: .8rem; }
  .log-line.error .lt { color: var(--bad); }
  .log-line.warning .lt { color: var(--warn); }
  .log-line.info .lt { color: var(--dim); }
  .log-line.success .lt { color: var(--ok); font-weight: 700; }
  .log-line.highlight .lt { color: var(--accent); }
  .log-stats { display: flex; gap: 1rem; margin-top: .6rem; font-size: .72rem; color: var(--dim); }
  .log-stats span b { color: var(--text); }

  /* build history */
  .build-timeline { display: flex; flex-direction: column; gap: .5rem; }

  /* watchdog */
  .watchdog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  .watchdog-section { background: var(--panel2); border: 1px solid var(--border); border-radius: 10px; padding: .9rem 1rem; }
  .watchdog-section h3 { font-size: .68rem; text-transform: uppercase; letter-spacing: .09em; color: var(--dim); margin: 0 0 .6rem; font-weight: 600; }
  .watchdog-row { display: flex; justify-content: space-between; align-items: center; gap: .8rem; padding: .35rem 0; font-size: .82rem; border-bottom: 1px solid var(--border); }
  .watchdog-row:last-child { border-bottom: none; padding-bottom: 0; }
  .watchdog-agent { color: var(--text); }
  .watchdog-agent small { display: block; color: var(--dim); font-size: .72rem; margin-top: .1rem; }
  .watchdog-status { font-weight: 700; font-size: .74rem; padding: .18rem .6rem; border-radius: 999px; white-space: nowrap; }
  .watchdog-status.working { color: var(--ok); background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.3); }
  .watchdog-status.idle { color: var(--warn); background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.3); }
  .watchdog-status.stalled { color: var(--bad); background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); }
  .watchdog-status.unknown { color: var(--dim); background: var(--panel); border: 1px solid var(--border); }
  .watchdog-meta { color: var(--dim); font-size: .74rem; margin-top: .4rem; }
  .watchdog-meta b { color: var(--text); }
  .stall-warn { color: var(--warn); font-size: .76rem; margin-top: .4rem; padding: .35rem .6rem; border-radius: 6px; background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.25); }
  .blocker-warn { color: var(--bad); font-size: .76rem; margin-top: .4rem; padding: .35rem .6rem; border-radius: 6px; background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.25); }
  .build-row {
    display: grid; grid-template-columns: auto 1fr auto auto; gap: .8rem; align-items: center;
    padding: .5rem .8rem; border-radius: 8px; background: var(--panel2); border: 1px solid var(--border);
    font-size: .82rem; cursor: pointer; transition: border-color .2s;
  }
  .build-row:hover { border-color: var(--accent); }
  .build-row.active { border-color: var(--accent); background: rgba(76,154,255,.06); }
  .build-id { font-weight: 700; color: var(--accent); min-width: 3rem; }
  .build-note { color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .build-errors { font-variant-numeric: tabular-nums; font-weight: 600; }
  .build-errors.good { color: var(--ok); }
  .build-errors.bad { color: var(--bad); }
  .build-errors.warn { color: var(--warn); }
  .build-dur { color: var(--dim); font-size: .74rem; }

  footer { margin-top: 2.2rem; color: var(--dim); font-size: .72rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; }
  button.refresh {
    background: var(--panel2); border: 1px solid var(--border); color: var(--dim);
    font: inherit; font-size: .72rem; padding: .25rem .8rem; border-radius: 999px; cursor: pointer;
  }
  button.refresh:hover { color: var(--text); border-color: var(--accent); }
  code { background: var(--panel2); padding: .1rem .35rem; border-radius: 4px; }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>Minecraft 1.21.1 <span>&rarr;</span> Browser <span>(TeaVM)</span></h1>
    <div class="live"><div class="dot" id="dot"></div><span id="liveLabel">connecting&hellip;</span></div>
  </header>
  <div class="subline" id="subhead">loading dashboard&hellip;</div>
  <div class="debug-line" id="debugLine"><b>debug:</b> initializing...</div>

  <div class="status-banner" id="banner"></div>

  <div class="stepper" id="stepper"></div>

  <div class="card wide" id="progressCard">
    <div class="progress-header">
      <h2>Error burn-down trend</h2>
      <span id="trendPill" class="trend-pill idle">no data</span>
    </div>
    <canvas class="burndown-canvas" id="burndownCanvas"></canvas>
    <div class="burndown-legend">
      <span><span class="legend-dot" style="background:var(--bad)"></span> total errors</span>
      <span><span class="legend-dot" style="background:var(--accent)"></span> unique symbols</span>
      <span><span class="legend-line" style="background:var(--ok)"></span> velocity fit</span>
      <span id="etaLegend" style="display:none;"><span class="legend-line" style="background:var(--purple);border-style:dashed"></span> ETA projection</span>
    </div>
  </div>

  <div class="card wide" id="watchdogCard" style="margin-bottom:1rem;">
    <h2>Watchdog — agent & project health</h2>
    <div id="watchdogContent">
      <span class="muted">waiting for watchdog data&hellip;</span>
    </div>
  </div>

  <div class="card wide" id="activityCard" style="margin-bottom:1rem;">
    <h2>Live activity feed</h2>
    <div class="feed" id="feed"><span class="muted">waiting for updates&hellip;</span></div>
  </div>

  <div class="card wide" id="peerWatchdogCard" style="margin-bottom:1rem;">
    <h2>Peer Watchdog — background agent monitoring (every 10m)</h2>
    <div id="peerWatchdogContent">
      <span class="muted">waiting for peer watchdog data&hellip;</span>
    </div>
  </div>

  <div class="grid">
    <div class="card">
      <h2>Last build</h2>
      <div class="pill" id="buildResult">no build yet</div>
      <div class="meta" id="buildMeta"></div>
    </div>

    <div class="card">
      <h2>Active subagents</h2>
      <div class="chips" id="agents"><span class="muted">none</span></div>
    </div>

    <div class="card wide">
      <h2>Errors by category</h2>
      <div id="errors"></div>
      <div class="total-line"><span>tracked total</span><b id="errTotal">0</b></div>
    </div>

    <div class="card wide">
      <h2>Build history</h2>
      <div class="build-timeline" id="buildTimeline"><span class="muted">loading&hellip;</span></div>
    </div>

    <div class="card wide">
      <h2>Strategy decisions</h2>
      <div class="dec-row">
        <span>Phase 3 &middot; rendering strategy</span>
        <span style="display:flex;align-items:center;gap:.7rem;">
          <span class="dec-val pending" id="renderVal">not yet decided</span><span class="tag pending" id="renderTag">pending</span>
        </span>
      </div>
      <div class="dec-row">
        <span>Phase 4 &middot; networking strategy</span>
        <span style="display:flex;align-items:center;gap:.7rem;">
          <span class="dec-val pending" id="netVal">not yet decided</span><span class="tag pending" id="netTag">pending</span>
        </span>
      </div>
    </div>

    <div class="card wide">
      <h2>Build log viewer</h2>
      <div class="log-controls">
        <select id="logSelect"><option value="006">build-006</option></select>
        <input class="filter-input" id="logFilter" placeholder="filter (e.g. ERROR, missing, TeaVM)..." />
        <button onclick="loadLog()">load</button>
        <button onclick="scrollLogBottom()">bottom</button>
      </div>
      <div class="log-viewer" id="logViewer"><span class="muted">select a build and click load</span></div>
      <div class="log-stats" id="logStats"></div>
    </div>
  </div>

  <footer>
    <span>live from <code id="serverAddr">server:9191</code> &middot; auto-refresh 5s</span>
    <button class="refresh" onclick="load()">refresh now</button>
  </footer>
</div>

<script>
const PHASES = [
  ['Compile pipeline', 'rebuild, no OOM'],
  ['Stub burn-down', 'classlib gaps'],
  ['Rendering', 'GL / WebGL2 bridge'],
  ['Networking', 'Netty / WebRTC'],
  ['Game loop', 'first frame &rarr; MP'],
];

let lastUpdated = null;
let currentPhase = 0;
let errorDetailData = {};
let currentLogBuild = '006';

function relTime(t) {
  if (!t) return null;
  const s = Math.max(0, Math.round((Date.now() - t) / 1000));
  return s < 60 ? s + 's ago' : Math.round(s / 60) + 'm ago';
}

function renderStepper(phase) {
  const el = document.getElementById('stepper');
  el.innerHTML = PHASES.map(([name, sub], i) => {
    const n = i + 1;
    const cls = n < phase ? 'done' : n === phase ? 'active' : '';
    const knob = n < phase ? '&#10003;' : n;
    return '<div class="step ' + cls + '"><div class="knob">' + knob + '</div><div class="step-label"><b>' + name + '</b>' + sub + '</div></div>';
  }).join('');
}

function renderBanner(d) {
  const errs = d.errors || {};
  const total = Object.values(errs).reduce((a, b) => a + b, 0);
  const br = d.last_build || {};
  const hist = d.build_history || [];
  const successBuilds = hist.filter(b => b.result === 'success').length;

  document.getElementById('banner').innerHTML =
    '<div class="stat-box"><div class="stat-label">Phase</div><div class="stat-val">' + (d.phase || '—') + '</div><div class="stat-sub">' + (d.phase_label || '') + '</div></div>' +
    '<div class="stat-box"><div class="stat-label">Total errors</div><div class="stat-val ' + (total === 0 ? 'ok' : total > 100 ? 'bad' : 'warn') + '">' + total + '</div><div class="stat-sub">stub gaps + threading</div></div>' +
    '<div class="stat-box"><div class="stat-label">Unique symbols</div><div class="stat-val">' + (br.note ? br.note.match(/\d+ unique/) ? br.note.match(/(\d+) unique/)[1] : '?' : '—') + '</div><div class="stat-sub">need stubs</div></div>' +
    '<div class="stat-box"><div class="stat-label">Builds done</div><div class="stat-val ok">' + successBuilds + '/' + hist.length + '</div><div class="stat-sub">success / total</div></div>' +
    '<div class="stat-box"><div class="stat-label">Last build</div><div class="stat-val ' + (br.result === 'success' ? 'ok' : 'bad') + '">' + (br.duration || '—') + '</div><div class="stat-sub">' + (br.build_id ? 'build-' + br.build_id : '') + '</div></div>';
}

function renderFeed(items) {
  const el = document.getElementById('feed');
  if (!items || items.length === 0) {
    el.innerHTML = '<span class="muted">waiting for updates&hellip;</span>';
    return;
  }
  el.innerHTML = items.slice().reverse().map(function(it) {
    const iconCls = it.type || 'action';
    const time = it.time ? new Date(it.time).toLocaleTimeString() : '';
    return '<div class="feed-item"><span class="feed-icon ' + iconCls + '">' + (it.icon || '>') + '</span>' +
      '<div class="feed-body"><span class="feed-text">' + it.text + '</span>' +
      (it.detail ? '<div class="feed-detail">' + it.detail + '</div>' : '') +
      '<span class="feed-time">' + time + '</span></div></div>';
  }).join('');
  el.scrollTop = 0;
}

function renderErrorDetails(errs) {
  errorDetailData = (errs && errs.detail) ? errs.detail : {};
}

function renderBuildTimeline(hist) {
  const el = document.getElementById('buildTimeline');
  if (!hist || hist.length === 0) {
    el.innerHTML = '<span class="muted">no build history</span>';
    return;
  }
  el.innerHTML = hist.map(function(b) {
    const rc = b.result === 'success' ? 'ok' : b.result === 'failure' ? 'bad' : 'warn';
    const ec = b.errors > 300 ? 'bad' : b.errors > 100 ? 'warn' : 'good';
    const active = b.id === currentLogBuild ? ' active' : '';
    return '<div class="build-row' + active + '" onclick="selectBuild(\'' + b.id + '\')">' +
      '<span class="build-id">build-' + b.id + '</span>' +
      '<span class="pill ' + rc + '" style="font-size:.72rem;padding:.15rem .6rem;">' + b.result + '</span>' +
      '<span class="build-errors ' + ec + '">' + b.errors + ' errors</span>' +
      '<span class="build-dur">' + (b.duration || '—') + '</span>' +
      '</div>';
  }).join('');
}

function selectBuild(id) {
  currentLogBuild = id;
  document.getElementById('logSelect').value = id;
  document.querySelectorAll('.build-row').forEach(function(r) {
    var bid = r.querySelector('.build-id').textContent.replace('build-', '');
    r.classList.toggle('active', bid === id);
  });
  loadLog();
}

var hist = [];
var progressCache = null;

/* ---- progress & burn-down ---- */

function parseUniqueFromNote(note) {
  if (!note) return null;
  var m = note.match(/(\d+)\s+unique/);
  return m ? parseInt(m[1]) : null;
}

function parseDurationToMinutes(dur) {
  if (!dur || dur === '—') return null;
  var parts = dur.split(':').map(Number);
  if (parts.length === 2) return parts[0] + parts[1] / 60;
  if (parts.length === 3) return parts[0] * 60 + parts[1] + parts[2] / 60;
  return null;
}

function linearRegression(points) {
  var n = points.length;
  if (n < 2) return null;
  var sx = 0, sy = 0, sxy = 0, sx2 = 0;
  for (var i = 0; i < n; i++) {
    sx += points[i].x; sy += points[i].y; sxy += points[i].x * points[i].y; sx2 += points[i].x * points[i].x;
  }
  var denom = n * sx2 - sx * sx;
  if (Math.abs(denom) < 1e-9) return null;
  var slope = (n * sxy - sx * sy) / denom;
  var intercept = (sy - slope * sx) / n;
  return { slope: slope, intercept: intercept, predict: function(x) { return slope * x + intercept; } };
}

function detectTrend(hist) {
  var valid = hist.filter(function(b) { return b.errors > 0 && b.result !== 'unknown'; });
  if (valid.length < 3) return { state: 'idle', label: 'no data', slope: 0, velocity: 0, etaBuilds: null, etaErrors: null };

  // Sort by build id ascending
  valid.sort(function(a, b) { return parseInt(a.id) - parseInt(b.id); });

  var points = valid.map(function(b, i) { return { x: i, y: b.errors }; });
  var reg = linearRegression(points);
  if (!reg) return { state: 'idle', label: 'insufficient data', slope: 0, velocity: 0, etaBuilds: null, etaErrors: null };

  var velocity = -reg.slope; // errors eliminated per build (positive = improving)
  var last = points[points.length - 1];
  var currentErrors = last.y;

  if (velocity < 0.5) {
    return { state: 'blocked', label: 'blocked (≤ 0.5 errs/build)', slope: reg.slope, velocity: 0, etaBuilds: null, etaErrors: null };
  }
  if (velocity < 1.5) {
    return { state: 'stalled', label: 'stalled (' + velocity.toFixed(1) + ' errs/build)', slope: reg.slope, velocity: velocity, etaBuilds: null, etaErrors: null };
  }

  // ETA: extrapolate to 0 errors
  var etaBuilds = currentErrors / velocity;
  return {
    state: 'improving',
    label: 'improving (' + velocity.toFixed(1) + ' errs/build)',
    slope: reg.slope,
    velocity: velocity,
    etaBuilds: Math.ceil(etaBuilds),
    etaErrors: Math.max(0, Math.round(reg.predict(points.length)))
  };
}

function drawBurndown(hist) {
  var canvas = document.getElementById('burndownCanvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var dpr = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  var W = rect.width, H = rect.height;

  var pad = { top: 18, right: 18, bottom: 32, left: 46 };
  var plotW = W - pad.left - pad.right;
  var plotH = H - pad.top - pad.bottom;

  ctx.clearRect(0, 0, W, H);

  var valid = hist.filter(function(b) { return b.errors > 0 && b.result !== 'unknown'; });
  if (valid.length < 2) {
    ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--dim').trim();
    ctx.font = '12px ui-monospace, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('need at least 2 successful builds to show trend', W / 2, H / 2);
    return;
  }
  valid.sort(function(a, b) { return parseInt(a.id) - parseInt(b.id); });

  var maxErr = 0;
  valid.forEach(function(b) { if (b.errors > maxErr) maxErr = b.errors; });
  maxErr = Math.ceil(maxErr * 1.08);

  var n = valid.length;
  var xOf = function(i) { return pad.left + (n <= 1 ? 0 : (i / (n - 1)) * plotW); };
  var yOf = function(v) { return pad.top + plotH - (v / maxErr) * plotH; };

  var gridColor = getComputedStyle(document.documentElement).getPropertyValue('--border').trim();
  var mutedColor = getComputedStyle(document.documentElement).getPropertyValue('--dim').trim();
  var accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
  var badColor = getComputedStyle(document.documentElement).getPropertyValue('--bad').trim();
  var okColor = getComputedStyle(document.documentElement).getPropertyValue('--ok').trim();
  var purpleColor = getComputedStyle(document.documentElement).getPropertyValue('--purple').trim();

  // grid lines
  ctx.strokeStyle = gridColor; ctx.lineWidth = 1;
  var gridLines = 5;
  ctx.fillStyle = mutedColor; ctx.font = '10px ui-monospace, monospace'; ctx.textAlign = 'right';
  for (var g = 0; g <= gridLines; g++) {
    var val = Math.round((maxErr / gridLines) * g);
    var y = yOf(val);
    ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + plotW, y); ctx.stroke();
    ctx.fillText(val, pad.left - 6, y + 3);
  }

  // x labels (show every Nth label to avoid crowding)
  ctx.textAlign = 'center';
  var labelEvery = n > 12 ? 3 : n > 6 ? 2 : 1;
  for (var i = 0; i < n; i++) {
    if (i % labelEvery === 0 || i === n - 1) {
      ctx.fillText('#' + valid[i].id, xOf(i), pad.top + plotH + 16);
    }
  }

  // regression line
  var points = valid.map(function(b, i) { return { x: i, y: b.errors }; });
  var reg = linearRegression(points);
  if (reg) {
    ctx.strokeStyle = okColor; ctx.lineWidth = 1.5; ctx.setLineDash([5, 4]);
    ctx.beginPath();
    var x0 = 0, x1 = n - 1;
    ctx.moveTo(xOf(x0), yOf(Math.max(0, reg.predict(x0))));
    ctx.lineTo(xOf(x1), yOf(Math.max(0, reg.predict(x1))));
    ctx.stroke();
    ctx.setLineDash([]);

    // ETA projection (dashed, purple) — extend beyond last point
    var trend = detectTrend(hist);
    if (trend.etaBuilds && trend.etaBuilds > 0) {
      var extX = x1 + trend.etaBuilds;
      var extY = reg.predict(extX);
      if (extY < maxErr) {
        ctx.strokeStyle = purpleColor; ctx.lineWidth = 1.5; ctx.setLineDash([3, 5]);
        ctx.beginPath();
        ctx.moveTo(xOf(x1), yOf(Math.max(0, reg.predict(x1))));
        ctx.lineTo(xOf(extX), yOf(Math.max(0, extY)));
        ctx.stroke();
        ctx.setLineDash([]);

        // marker at projected zero
        var zeroX = x0 + (0 - reg.intercept) / reg.slope;
        if (zeroX >= x1 && zeroX <= extX) {
          ctx.fillStyle = purpleColor;
          ctx.beginPath();
          ctx.arc(xOf(zeroX), yOf(0), 4, 0, Math.PI * 2);
          ctx.fill();
          ctx.font = '10px ui-monospace, monospace'; ctx.textAlign = 'center';
          ctx.fillText('~build ' + (parseInt(valid[valid.length - 1].id) + Math.round(zeroX - x1)), xOf(zeroX), yOf(0) - 8);
        }
      }
    }
  }

  // total errors area + dots
  ctx.fillStyle = badColor.replace(')', ',0.12)').replace('rgb', 'rgba');
  ctx.beginPath();
  ctx.moveTo(xOf(0), yOf(0));
  for (var i = 0; i < n; i++) { ctx.lineTo(xOf(i), yOf(Math.max(0, valid[i].errors))); }
  ctx.lineTo(xOf(n - 1), yOf(0));
  ctx.closePath(); ctx.fill();

  ctx.fillStyle = badColor;
  for (var i = 0; i < n; i++) {
    ctx.beginPath();
    ctx.arc(xOf(i), yOf(Math.max(0, valid[i].errors)), 4, 0, Math.PI * 2);
    ctx.fill();
  }

  // unique symbols line + dots
  ctx.strokeStyle = accentColor; ctx.lineWidth = 2;
  ctx.beginPath();
  var uniqStarted = false;
  for (var i = 0; i < n; i++) {
    var u = parseUniqueFromNote(valid[i].note);
    if (u === null) continue;
    var px = xOf(i), py = yOf(Math.min(u, maxErr));
    if (!uniqStarted) { ctx.moveTo(px, py); uniqStarted = true; } else { ctx.lineTo(px, py); }
  }
  ctx.stroke();
  ctx.fillStyle = accentColor;
  for (var i = 0; i < n; i++) {
    var u = parseUniqueFromNote(valid[i].note);
    if (u === null) continue;
    ctx.beginPath();
    ctx.arc(xOf(i), yOf(Math.min(u, maxErr)), 3, 0, Math.PI * 2);
    ctx.fill();
  }

  // last build highlight
  if (n > 0) {
    var lx = xOf(n - 1), ly = yOf(Math.max(0, valid[n - 1].errors));
    ctx.strokeStyle = badColor; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(lx, ly, 8, 0, Math.PI * 2); ctx.stroke();
  }
}

function renderPeerWatchdog(d) {
  var pwd = d.peer_watchdog;
  var el = document.getElementById('peerWatchdogContent');
  if (!pwd) {
    el.innerHTML = '<span class="muted">peer watchdog not running yet</span>';
    return;
  }

  var last = pwd.last_check || {};
  var history = pwd.history || [];

  // Current check
  var agents = last.agents || [];
  var total = last.total || 0;
  var idle = last.idle_count || 0;
  var busy = last.busy_count || 0;

  var agentRows = agents.map(function(a) {
    var statusCls = a.status === 'busy' ? 'working' : 'idle';
    var started = a.started || 'unknown';
    return '<div class="watchdog-row">' +
      '<div class="watchdog-agent">' + escapeHtml(a.name) + '<small>' + escapeHtml(started) + '</small></div>' +
      '<span class="watchdog-status ' + statusCls + '">' + a.status + '</span>' +
      '</div>';
  }).join('');

  if (agents.length === 0) {
    agentRows = '<div class="watchdog-row"><span class="muted">no peer agents found</span></div>';
  }

  // History (last 5)
  var historyHtml = history.slice(-5).map(function(h) {
    var time = new Date(h.timestamp).toLocaleTimeString();
    return '<div class="watchdog-meta" style="margin-bottom:.3rem;">' +
      '<b>' + time + '</b> — ' + h.total + ' agents (' + h.busy_count + ' busy, ' + h.idle_count + ' idle)' +
      '</div>';
  }).reverse().join('');

  el.innerHTML =
    '<div class="watchdog-grid">' +
      '<div class="watchdog-section"><h3>Peer agents (current)</h3>' + agentRows + '</div>' +
      '<div class="watchdog-section"><h3>Last 5 checks</h3>' + historyHtml + '</div>' +
    '</div>';
}

function renderWatchdog(d) {
  var wd = d.watchdog;
  var el = document.getElementById('watchdogContent');
  if (!wd) {
    el.innerHTML = '<span class="muted">watchdog not running yet</span>';
    return;
  }

  var agents = wd.agents || {};
  var agentIds = Object.keys(agents);
  var build = wd.build || {};
  var project = wd.project || {};
  var stalled = wd.stalled || {};

  // Agent health rows
  var agentRows = agentIds.map(function(aid) {
    var a = agents[aid];
    var taskText = a.task ? '<small>' + escapeHtml(a.task) + '</small>' : '';
    var detailText = a.detail ? '<small>' + escapeHtml(a.detail) + '</small>' : '';
    var ageText = a.age_seconds < 60 ? a.age_seconds + 's' : Math.round(a.age_seconds / 60) + 'm';
    return '<div class="watchdog-row">' +
      '<div class="watchdog-agent">' + escapeHtml(aid) + taskText + detailText + '</div>' +
      '<span class="watchdog-status ' + a.status + '">' + a.status + ' (' + ageText + ')</span>' +
      '</div>';
  }).join('');

  if (agentIds.length === 0) {
    agentRows = '<div class="watchdog-row"><span class="muted">no agents reporting yet</span></div>';
  }

  // Build health
  var buildStatusClass = build.status === 'improving' ? 'working' : build.status === 'stale' ? 'stalled' : build.status === 'regressing' ? 'stalled' : 'idle';
  var buildHtml = '<div class="watchdog-row"><span>Build health</span><span class="watchdog-status ' + buildStatusClass + '">' + escapeHtml(build.status) + '</span></div>' +
    (build.message ? '<div class="watchdog-meta">' + escapeHtml(build.message) + '</div>' : '');

  // Project health
  var projStatusClass = project.status === 'complete' ? 'working' : project.status === 'progressing' ? 'working' : project.status === 'blocked' ? 'stalled' : 'idle';
  var projHtml = '<div class="watchdog-row"><span>Project</span><span class="watchdog-status ' + projStatusClass + '">' + escapeHtml(project.status) + '</span></div>' +
    (project.message ? '<div class="watchdog-meta">' + escapeHtml(project.message) + ' (' + project.total_errors + ' errors)</div>' : '');

  // Warnings
  var warnings = '';
  if (stalled.stalled) {
    warnings += '<div class="stall-warn">⚠ Progress stalled: ' + escapeHtml(stalled.reason) + '</div>';
  }
  if (project.has_blocker) {
    warnings += '<div class="blocker-warn">🚧 Structural blocker detected — needs human intervention</div>';
  }

  el.innerHTML =
    '<div class="watchdog-grid">' +
      '<div class="watchdog-section"><h3>Agents</h3>' + agentRows + '</div>' +
      '<div class="watchdog-section"><h3>Build & project</h3>' + buildHtml + projHtml + warnings + '</div>' +
    '</div>';
}

function escapeHtml(text) {
  var div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function renderProgress(d) {
  var h = d.build_history || [];
  if (!progressCache || progressCache.length !== h.length || (h.length > 0 && progressCache[0].id !== h[0].id)) {
    progressCache = h.slice();
    drawBurndown(h);
  }

  var trend = detectTrend(h);
  var pill = document.getElementById('trendPill');
  pill.className = 'trend-pill ' + trend.state;
  pill.textContent = trend.label;

  // Update status banner with progress stats
  var banner = document.getElementById('banner');
  var errs = d.errors || {};
  var total = Object.values(errs).reduce(function(a, b) { return a + b; }, 0);
  var unique = parseUniqueFromNote((d.last_build && d.last_build.note) || '') || 0;
  var br = d.last_build || {};
  var successBuilds = h.filter(function(b) { return b.result === 'success'; }).length;
  var pct = 0;
  if (h.length >= 2) {
    var sorted = h.slice().sort(function(a, b) { return parseInt(a.id) - parseInt(b.id); });
    var firstErr = sorted[0].errors;
    var lastErr = sorted[sorted.length - 1].errors;
    pct = firstErr > 0 ? Math.round((1 - lastErr / firstErr) * 100) : 0;
    if (pct < 0) pct = 0; if (pct > 99) pct = 99;
  }

  var etaText = '—';
  if (trend.etaBuilds) {
    etaText = '~' + trend.etaBuilds + ' builds';
  }
  var velText = trend.velocity > 0 ? trend.velocity.toFixed(1) + ' errs/build' : '—';

  banner.innerHTML =
    '<div class="stat-box"><div class="stat-label">Progress</div><div class="stat-val ok">' + (total === 0 ? 'done' : pct + '%') + '</div><div class="stat-sub">' + (total === 0 ? 'all errors resolved' : h.length + ' builds recorded') + '</div></div>' +
    '<div class="stat-box"><div class="stat-label">Current errors</div><div class="stat-val ' + (total === 0 ? 'ok' : total > 100 ? 'bad' : 'warn') + '">' + total + '</div><div class="stat-sub">' + unique + ' unique · ' + Object.keys(errs).length + ' categories</div></div>' +
    '<div class="stat-box"><div class="stat-label">Velocity</div><div class="stat-val">' + velText + '</div><div class="stat-sub">' + (trend.state === 'blocked' ? 'stalled — structural blocker' : trend.state === 'stalled' ? 'below threshold' : 'errors eliminated per build') + '</div></div>' +
    '<div class="stat-box"><div class="stat-label">ETA (zero errors)</div><div class="stat-val ' + (trend.etaBuilds ? 'ok' : '') + '">' + etaText + '</div><div class="stat-sub">' + (trend.etaBuilds ? 'at current velocity' : 'need ≥ 2 builds w/ errors') + '</div></div>' +
    '<div class="stat-box"><div class="stat-label">Last build</div><div class="stat-val ' + (br.result === 'success' ? 'ok' : 'bad') + '">' + (br.duration || '—') + '</div><div class="stat-sub">' + (br.build_id ? 'build-' + br.build_id : '') + '</div></div>';
}

async function loadBuildHistory() {
  try {
    const res = await fetch('/api/builds?_=' + Date.now());
    const data = await res.json();
    const sel = document.getElementById('logSelect');
    sel.innerHTML = data.builds.map(function(b) {
      return '<option value="' + b.id + '"' + (b.id === currentLogBuild ? ' selected' : '') + '>build-' + b.id + ' (' + b.result + ')</option>';
    }).join('');
  } catch(e) {}
}

function highlightLogLine(line) {
  var cls = 'info';
  if (line.indexOf('[ERROR]') !== -1) cls = 'error';
  else if (line.indexOf('[WARNING]') !== -1) cls = 'warning';
  else if (line.indexOf('BUILD SUCCESS') !== -1) cls = 'success';
  else if (line.indexOf('missing') !== -1 || line.indexOf('not found') !== -1) cls = 'highlight';
  return cls;
}

function renderLog(text, filter) {
  var lines = text.split('\n');
  var filterLower = (filter || '').toLowerCase();
  var filtered = filterLower ? lines.filter(function(l) { return l.toLowerCase().indexOf(filterLower) !== -1; }) : lines;
  var el = document.getElementById('logViewer');
  if (filtered.length === 0) {
    el.innerHTML = '<span class="muted">no lines match filter</span>';
  } else {
    el.innerHTML = filtered.map(function(line, i) {
      var cls = highlightLogLine(line);
      var ln = filterLower ? '' : '<span class="ln">' + (i + 1) + '</span>';
      var escaped = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return '<div class="log-line ' + cls + '">' + ln + '<span class="lt">' + escaped + '</span></div>';
    }).join('');
  }
  var errCount = lines.filter(function(l) { return l.indexOf('[ERROR]') !== -1; }).length;
  var warnCount = lines.filter(function(l) { return l.indexOf('[WARNING]') !== -1; }).length;
  document.getElementById('logStats').innerHTML =
    '<span>lines: <b>' + lines.length + '</b></span>' +
    '<span>errors: <b style="color:var(--bad)">' + errCount + '</b></span>' +
    '<span>warnings: <b style="color:var(--warn)">' + warnCount + '</b></span>' +
    (filterLower ? '<span>showing: <b>' + filtered.length + '</b> filtered</span>' : '');
}

async function loadLog() {
  var buildNum = document.getElementById('logSelect').value || '006';
  currentLogBuild = buildNum;
  var filter = document.getElementById('logFilter').value;
  var el = document.getElementById('logViewer');
  el.innerHTML = '<span class="muted">loading build-' + buildNum + '.log&hellip;</span>';
  try {
    var res = await fetch('/api/log/' + buildNum + '?tail=500');
    var text = await res.text();
    renderLog(text, filter);
  } catch(e) {
    el.innerHTML = '<span class="muted">failed to load log</span>';
  }
}

function scrollLogBottom() {
  var el = document.getElementById('logViewer');
  el.scrollTop = el.scrollHeight;
}

document.getElementById('logFilter').addEventListener('keyup', function(e) {
  if (e.key === 'Enter') loadLog();
});

async function loadErrors() {
  try {
    var res = await fetch('/api/errors?_=' + Date.now());
    var data = await res.json();
    renderErrorDetails(data);
  } catch(e) {}
}

async function load() {
  try {
    const res = await fetch('/dashboard.json?_=' + Date.now());
    const d = await res.json();

    document.getElementById('dot').classList.add('on');
    document.getElementById('liveLabel').textContent = 'live';

    lastUpdated = d.updated_at ? new Date(d.updated_at) : null;
    document.getElementById('subhead').textContent = lastUpdated
      ? 'phase ' + d.phase + ' \u2014 updated ' + relTime(lastUpdated) + ' \u2014 live every 2s'
      : 'phase ' + d.phase + ' \u2014 awaiting first update';

    currentPhase = d.phase ?? 0;
    renderStepper(currentPhase);

    hist = d.build_history || [];
    renderBuildTimeline(hist);
    renderBanner(d);
    renderWatchdog(d);
    renderPeerWatchdog(d);
    renderProgress(d);

    const br = d.last_build || {};
    const pill = document.getElementById('buildResult');
    if (br.result === 'success') { pill.textContent = '\u2713 success'; pill.className = 'pill ok'; }
    else if (br.result === 'fail') { pill.textContent = '\u2717 fail'; pill.className = 'pill bad'; }
    else { pill.textContent = 'no build yet'; pill.className = 'pill'; }
    document.getElementById('buildMeta').textContent =
      [br.timestamp, br.log_path, br.note].filter(Boolean).join(' \u00b7 ');

    const agentsEl = document.getElementById('agents');
    const agents = d.active_subagents || [];
    agentsEl.innerHTML = agents.length
      ? agents.map(a => '<span class="chip">' + a + '</span>').join('')
      : '<span class="muted">none</span>';

    const errs = d.errors || {};
    const cats = [
      ['stub_gap', 'stub gaps', ''],
      ['gl_rendering', 'GL / rendering', 'red'],
      ['netty_threading', 'Netty / threading', 'amber'],
      ['teavm_classpath', 'TeaVM classpath', ''],
      ['other', 'other', ''],
    ];
    const max = Math.max(1, ...cats.map(([k]) => errs[k] || 0));
    const total = cats.reduce((a, [k]) => a + (errs[k] || 0), 0);
    const errDetail = errorDetailData;
    document.getElementById('errors').innerHTML = cats.map(([k, label, color]) => {
      const v = errs[k] || 0;
      const pct = v === 0 ? 0 : Math.max(4, Math.round(v / max * 100));
      var detailHtml = '';
      var btnHtml = '';
      if (errDetail[k] && Object.keys(errDetail[k]).length > 0) {
        var syms = Object.entries(errDetail[k]).sort((a, b) => b[1] - a[1]);
        var panelId = 'err-detail-' + k;
        detailHtml = '<div class="err-detail-panel" id="' + panelId + '">' +
          syms.map(function(s) {
            var name = s[0].length > 70 ? s[0].substring(0, 67) + '...' : s[0];
            var escaped = name.replace(/&/g, '&amp;').replace(/</g, '&lt;');
            return '<div class="err-detail-row"><span class="err-detail-sym"><code>' + escaped + '</code></span><span class="err-detail-cnt">' + s[1] + '</span></div>';
          }).join('') + '</div>';
        btnHtml = '<button class="expand-btn" onclick="toggleErrDetail(\'' + k + '\')">show ' + syms.length + ' symbols</button>';
      }
      return '<div class="err-row"><span class="err-name">' + label + '</span>' +
        '<span class="bar-track"><span class="bar-fill ' + (v === 0 ? 'zero' : color) + '" style="width:' + pct + '%"></span></span>' +
        '<span class="err-num">' + v + '</span></div>' + detailHtml + btnHtml;
    }).join('');
    const totEl = document.getElementById('errTotal');
    totEl.textContent = total;
    totEl.style.color = total === 0 ? 'var(--ok)' : 'var(--bad)';

    renderFeed(d.activity || []);

    if (d.decisions) {
      if (d.decisions.rendering_strategy) {
        document.getElementById('renderVal').textContent = d.decisions.rendering_strategy;
        document.getElementById('renderVal').className = 'dec-val';
        document.getElementById('renderTag').className = 'tag locked';
        document.getElementById('renderTag').textContent = 'locked';
      }
      if (d.decisions.networking_strategy) {
        document.getElementById('netVal').textContent = d.decisions.networking_strategy;
        document.getElementById('netVal').className = 'dec-val';
        document.getElementById('netTag').className = 'tag locked';
        document.getElementById('netTag').textContent = 'locked';
      }
    }
  } catch (e) {
    document.getElementById('dot').classList.remove('on');
    document.getElementById('liveLabel').textContent = 'offline';
    document.getElementById('subhead').textContent = 'cannot reach dashboard server';
  }
}

function toggleErrDetail(cat) {
  var el = document.getElementById('err-detail-' + cat);
  if (!el) return;
  el.classList.toggle('open');
  var btn = el.previousElementSibling;
  if (btn && btn.classList.contains('expand-btn')) {
    btn.textContent = el.classList.contains('open') ? 'collapse' : btn.textContent.replace('show', 'show');
  }
}

function tick() {
  if (lastUpdated) {
    document.getElementById('subhead').textContent =
      'phase ' + currentPhase + ' \u2014 updated ' + relTime(lastUpdated);
  }
}

window.addEventListener('resize', function() {
  if (progressCache && progressCache.length > 0) {
    drawBurndown(progressCache);
  }
});

// Main update loop - every 2 seconds for more responsive feel
load();
loadErrors();
loadBuildHistory();
setInterval(load, 2000);
setInterval(tick, 1000);
</script>
</body>
</html>
